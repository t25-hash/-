<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      登録済み送信先の生存確認(PackageManager#getActivityInfo)がAndroid 11以降の
      パッケージ可視性フィルタで誤って「存在しない」と判定されないよう、text/plainの
      共有先アプリを可視にする。startActivities()は1つでも解決できないと配列全体が
      失敗するため、この事前確認が必須。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="true">

        <activity
            android:name=".QuickMemoActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickMemo"
            android:windowSoftInputMode="stateVisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AiLogViewActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickMemo" />

        <receiver
            android:name=".NothingWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nothing_widget_info" />
        </receiver>

        <receiver
            android:name=".ChosenComponentReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
